OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Leave blank to use local SQLite; set to Supabase connection string for production
DATABASE_URL=

# Set DEBUG=true explicitly for local development. Production defaults to false.
SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional production overrides (secure defaults are enabled when DEBUG=false)
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true
# DATABASE_SSL_MODE=require
# DATABASE_SSL_ROOT_CERT=/path/to/prod-ca-2021.crt
# AUTH_TOKEN_TTL_HOURS=12
# DATA_UPLOAD_MAX_MEMORY_SIZE=2097152
# THROTTLE_ANON_RATE=60/min
# THROTTLE_USER_RATE=300/min
# THROTTLE_LOGIN_RATE=10/min
# THROTTLE_REGISTER_RATE=5/hour
# THROTTLE_AI_CHAT_RATE=10/min
# THROTTLE_PEER_MESSAGE_RATE=120/min
